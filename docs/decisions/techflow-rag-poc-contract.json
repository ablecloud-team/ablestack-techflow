  "sourcePolicy": {
    "branchHeadTracking": "LATEST_CANDIDATE_PINNED_ON_APPROVAL",
    "branchIsolationRequired": true,
    "sourceProfileRequiredForCodeQuery": true,
    "compatibilitySetRequiredForCrossRepositoryQuery": true,
    "crossBranchFusionAllowed": false,
    "unapprovedCrossRepositoryFusionAllowed": false,
    "allowedSourceKinds": ["DOCUMENTATION", "SOURCE_CODE", "TEST_CODE", "BUILD_SCHEMA"],
    "allowedCodeExtensions": ["java", "py", "js", "jsx", "ts", "tsx", "vue", "go", "rb", "groovy", "cs", "sh", "bash", "c", "cc", "cpp", "h", "hpp", "rs", "ps1", "cmd", "bat", "html", "htm", "css", "scss", "sass", "less", "hbs"],
    "allowedSchemaExtensions": ["xml", "sql", "yaml", "yml", "properties", "json", "toml", "ini", "conf", "cfg", "service", "spec", "ks", "repo", "j2", "tmpl", "in"],
    "allowedRepositoryDocumentExtensions": ["md", "mdx", "adoc", "rst"],
    "excludedPathSegments": ["target", "build", "dist", "node_modules", "vendor", "third_party", "generated", "gen"],
    "excludedPatterns": ["*.min.js", "*.min.css"],
    "maximumTextFileBytes": 1048576,
    "binaryFilesAllowed": false,
    "repositoryHooksAllowed": false,
    "buildOrCodeExecutionAllowed": false,
    "testCodeEvidenceRole": "CORROBORATIVE",
    "testCodeMayBeSoleCitation": false,
    "licenseMetadataIsIngestionBlocker": false,
    "repositoryAccessAuthorizationRequired": true
  },
  "dataGate": {
    "D0": {"collectionDefault": true, "embeddingAllowed": true, "providerAllowed": true},
    "D1": {"collectionDefault": false, "embeddingAllowed": false, "providerAllowed": false},
    "D2": {"collectionDefault": false, "embeddingAllowed": false, "providerAllowed": false},
    "D3": {"collectionDefault": false, "embeddingAllowed": false, "providerAllowed": false},
    "rawPromptPersistence": false,
    "rawResponsePersistence": false,
    "credentialPersistence": false
  },
  "runtime": {
    "language": "python-3.12",
    "apiFramework": "fastapi",
    "databaseEngine": "postgresql-14",
    "vectorExtension": "pgvector-0.8.0",
    "identifierExtension": "pg_trgm",
    "parser": "tree-sitter-with-deterministic-line-fallback",
    "database": "techflow_rag",
    "appRole": "techflow_rag_app",
    "migrationRole": "techflow_rag_migrator",
    "fetcherRole": "techflow_rag_source_fetcher",
    "cache": "redis-short-ttl",
    "externalIngress": false,
    "allowedEgress": ["github.com", "api.github.com", "approved-provider-endpoint"]
  },
  "sourceStates": ["REGISTERED", "QUARANTINED", "APPROVED", "INDEXING", "ACTIVE", "REJECTED", "FAILED", "WITHDRAWN", "DELETION_REQUESTED", "DELETED"],
  "jobStates": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"],
  "queryStates": ["ANSWERED", "ABSTAINED", "FAILED"],
  "failureClasses": ["RETRYABLE", "TERMINAL", "MANUAL_REVIEW"],
  "tables": [
    {"name": "rag_source", "purpose": "source identity classification source profile and state"},
    {"name": "rag_source_version", "purpose": "immutable branch commit blob and content hashes"},
    {"name": "rag_compatibility_set", "purpose": "approved product release and component combination"},
    {"name": "rag_compatibility_set_source", "purpose": "source profiles and pinned versions allowed in a compatibility set"},
    {"name": "rag_ingestion_job", "purpose": "ingestion state attempt and allow-listed error"},
    {"name": "rag_chunk", "purpose": "deterministic documentation code test and schema chunks"},
    {"name": "rag_embedding_profile", "purpose": "provider model dimension and profile version without credentials"},
    {"name": "rag_chunk_embedding", "purpose": "chunk vector by one active profile"},
    {"name": "rag_code_symbol", "purpose": "language package symbol signature and line range"},
    {"name": "rag_code_relation", "purpose": "import inheritance declaration and reference edges"},
    {"name": "rag_deletion_ledger", "purpose": "withdrawal and derived-store deletion evidence"},
    {"name": "rag_evaluation_case", "purpose": "approved D0 documentation and code golden questions"},
    {"name": "rag_evaluation_run", "purpose": "profile and commit bound evaluation run"},
    {"name": "rag_evaluation_result", "purpose": "sanitized scores status and citation ids"},
    {"name": "rag_provider_call", "purpose": "sanitized provider request response ids model profile token latency status and error metadata without raw content"}
  ],
  "api": [
    {"method": "GET", "path": "/healthz", "purpose": "process database parser and vector health", "idempotencyRequired": false},
    {"method": "POST", "path": "/v1/sources", "purpose": "register documentation or code source version", "idempotencyRequired": true},
    {"method": "GET", "path": "/v1/sources/{sourceId}", "purpose": "read source and product profile status", "idempotencyRequired": false},
    {"method": "POST", "path": "/v1/compatibility-sets", "purpose": "register an approved cross repository source profile combination", "idempotencyRequired": true},
    {"method": "POST", "path": "/v1/sources/{sourceId}/approve", "purpose": "approve quarantined source and branch commit", "idempotencyRequired": true},
    {"method": "POST", "path": "/v1/sources/{sourceId}/ingestions", "purpose": "create documentation or code ingestion job", "idempotencyRequired": true},
    {"method": "DELETE", "path": "/v1/sources/{sourceId}", "purpose": "withdraw and delete source profile", "idempotencyRequired": true},
    {"method": "GET", "path": "/v1/jobs/{jobId}", "purpose": "read fetch parse index and deletion job state", "idempotencyRequired": false},
    {"method": "POST", "path": "/v1/rag/query", "purpose": "retrieve documentation and branch-isolated code evidence", "idempotencyRequired": false, "queryIdRequired": true},
    {"method": "POST", "path": "/v1/evaluations/runs", "purpose": "create documentation and code evaluation run", "idempotencyRequired": true},
    {"method": "GET", "path": "/v1/evaluations/runs/{runId}", "purpose": "read evaluation result by product profile and commit", "idempotencyRequired": false}
  ],
  "quarantine": {
    "maxFileBytes": 1048576,
    "maxCommitBytes": 157286400,
    "checks": ["repository-allowlist", "branch-allowlist", "commit-pin", "path-allowlist", "extension", "mime", "encoding", "control-characters", "secret-patterns", "personal-data-patterns", "instruction-injection-patterns", "unsafe-links", "generated-vendor-path", "binary-file"],
    "requiresHumanApproval": true,
    "partialActivationAllowed": false
  },
  "chunkingProfiles": {
    "DOCUMENTATION": {"strategy": "heading-aware", "targetTokens": 700, "overlapTokens": 100, "preserve": ["heading-path", "lists", "table-header", "code-block"]},
    "SOURCE_CODE": {"strategy": "symbol-aware-tree-sitter", "targetTokens": 1200, "overlapTokens": 120, "preserve": ["package", "imports", "annotations", "signature", "doc-comment", "line-range"], "fallback": "160-lines-overlap-20"},
    "TEST_CODE": {"strategy": "symbol-aware-tree-sitter", "targetTokens": 1000, "overlapTokens": 100, "evidenceRole": "CORROBORATIVE"},
    "BUILD_SCHEMA": {"strategy": "logical-block", "targetTokens": 900, "overlapTokens": 80, "preserve": ["element-path", "property-name", "statement-boundary"]},
    "normalization": "unicode-nfc-lf",
    "deterministicId": true,
    "profileVersionRequired": true
  },
  "retrieval": {
    "mode": "hybrid-exact-identifier",
    "vectorDistance": "cosine",
    "vectorCandidateCount": 30,
    "ftsCandidateCount": 20,
    "identifierCandidateCount": 20,
    "fusion": "reciprocal-rank-fusion",
    "fusionConstant": 60,
    "finalTopK": 10,
    "maxChunksPerSourceVersion": 4,
    "authorizationFilterBeforeRetrieval": true,
    "sourceProfileFilterBeforeRetrieval": true,
    "compatibilitySetFilterBeforeRetrieval": true,
    "branchCommitFilterBeforeRetrieval": true,
    "crossBranchFusionAllowed": false,
    "unapprovedCrossRepositoryFusionAllowed": false,
    "testEvidenceWeight": 0.6,
    "hnsw": {"enabled": false, "minimumActiveChunksForEvaluation": 50000, "maximumRecallLossPercentagePoints": 2, "requiresBenchmark": true}
  },
  "answer": {
    "citationRequiredForAnswered": true,
    "citationFields": ["sourceId", "sourceVersion", "repository", "branch", "commit", "path", "startLine", "endLine", "symbol", "chunkId"],
    "answerMustNameSourceProfiles": true,
    "answerMustNameCompatibilitySetWhenUsed": true,
    "branchConflictMustAbstain": true,
    "testOnlyEvidenceMustAbstain": true,
    "abstainReasons": ["no-grounding", "source-conflict", "branch-conflict", "compatibility-conflict", "test-only-evidence", "unsupported-product", "unsupported-version", "citation-validation-failed"],
    "documentsAndCodeAreInstructions": false,
    "toolsEnabled": false
  },
  "provider": {
    "vendor": "openai",
    "adapter": "openai-official-python-sdk",
    "runtimeSurface": "responses-api",
    "embeddingSurface": "embeddings-api",
    "batchSurface": "conditional-offline-index-and-evaluation",
    "chatgptWorkRole": "optional-human-reviewed-operations-and-artifact-authoring",
    "codexRole": "optional-development-code-review-and-offline-evaluation-authoring",
    "agentsSdkEnabled": false,
    "hostedToolsEnabled": false,
    "oneActiveEmbeddingProfile": true,
    "credentialStorage": "protected-runtime-injection",
    "profileFields": ["endpoint", "runtimeSurface", "chatModel", "reasoningEffort", "embeddingModel", "embeddingDimension", "profileVersion", "requestedModelId", "returnedModelId"],
    "profiles": {
      "default": {"id": "OPENAI_RAG_DEFAULT_V1", "model": "gpt-5.6-terra", "reasoningEffort": "medium", "use": "routine-grounded-technical-support"},
      "escalation": {"id": "OPENAI_RAG_ESCALATION_V1", "model": "gpt-5.6-sol", "reasoningEffort": "high", "use": "deterministic-pre-call-complexity-or-source-conflict"},
      "embedding": {"id": "OPENAI_EMBEDDING_V1", "model": "text-embedding-3-large", "dimension": 3072, "benchmarkAlternatives": ["text-embedding-3-large-1536", "text-embedding-3-large-1024", "text-embedding-3-small"]}
    },
    "routing": {
      "decisionOwner": "techflow-ai-gateway",
      "decisionTime": "before-provider-call",
      "deterministicSignals": ["source-conflict", "source-version-count", "compatibility-set-component-count"],
      "modelSelfRoutingAllowed": false,
      "automaticSecondCallOnLowConfidenceAllowed": false
    },
    "request": {
      "store": false,
      "background": false,
      "stream": false,
      "structuredOutputRequired": true,
      "tools": [],
      "maximumContextChunks": 10,
      "wholeRepositoryUploadAllowed": false,
