      "zeroDataRetentionOrModifiedAbuseMonitoringRequiredForD1Plus": true,
      "dataResidencyDecisionRequiredBeforeProduction": true
    },
    "retry": {
      "classes": ["network-timeout", "http-429", "http-5xx"],
      "maximumAttempts": 3,
      "connectTimeoutSeconds": 3,
      "totalTimeoutSeconds": 12,
      "backoff": "exponential-jitter"
    },
    "circuitBreaker": {"windowMinutes": 5, "minimumCalls": 10, "failureRateToOpen": 0.5, "openSeconds": 60, "halfOpenCalls": 1},
    "promptCacheExplicitlyEnabled": false,
    "modelChangeRequiresNewProfileAndGoldenSet": true
  },
  "deletion": {
