  "components": {
    "schemas": {
      "ApiMeta": {
        "properties": {
          "correlationId": {
            "type": "string",
            "title": "Correlationid"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Generatedat"
          },
          "apiVersion": {
            "type": "string",
            "title": "Apiversion",
            "default": "v1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "correlationId"
        ],
        "title": "ApiMeta"
      },
      "CompatibilityMember": {
        "properties": {
          "sourceVersionId": {
            "type": "string",
            "format": "uuid",
            "title": "Sourceversionid"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sourceVersionId"
        ],
        "title": "CompatibilityMember"
      },
      "CompatibilitySetCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "title": "Name"
          },
          "product": {
            "type": "string",
            "const": "ABLESTACK",
            "title": "Product",
            "default": "ABLESTACK"
          },
          "productVersion": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Productversion"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/CompatibilityMember"
            },
            "type": "array",
            "maxItems": 16,
            "minItems": 1,
            "title": "Members"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "productVersion",
          "members"
        ],
        "title": "CompatibilitySetCreateRequest"
      },
      "Envelope": {
        "properties": {
          "data": {
            "title": "Data"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "title": "Envelope"
      },
      "EvaluationRunCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "title": "Name"
          },
          "sourceProfileIds": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                },
                "type": "array",
                "maxItems": 9,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourceprofileids"
          },
          "compatibilitySetId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compatibilitysetid"
          },
          "providerProfileId": {
            "type": "string",
            "enum": [
              "OPENAI_RAG_DEFAULT_V1",
              "OPENAI_RAG_ESCALATION_V1"
            ],
            "title": "Providerprofileid"
          },
          "requestedBy": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:@-]{3,128}$",
            "title": "Requestedby"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "providerProfileId",
          "requestedBy"
        ],
        "title": "EvaluationRunCreateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestionCreateRequest": {
        "properties": {
          "requestedBy": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:@-]{3,128}$",
            "title": "Requestedby"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requestedBy"
        ],
        "title": "IngestionCreateRequest"
      },
      "JobCompletionRequest": {
        "properties": {
          "succeeded": {
            "type": "boolean",
            "title": "Succeeded"
          },
          "indexedFileCount": {
            "type": "integer",
            "minimum": 0.0,
