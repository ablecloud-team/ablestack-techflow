# Images
AP_IMAGE=ghcr.io/activepieces/activepieces:0.86.3

# Private test-server listener and canonical public URL.
AP_BIND_ADDRESS=172.16.0.231
AP_HTTP_PORT=8080
AP_FRONTEND_URL=https://techflow.ablecloud.io
TECHFLOW_PUBLIC_URL=https://techflow.ablecloud.io

# Runtime-generated secrets. Never commit populated values.
AP_API_KEY=
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=
AP_POSTGRES_PASSWORD=
AP_REDIS_PASSWORD=
TECHFLOW_WEBHOOK_SECRET=

# PostgreSQL
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=activepieces

# Redis
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379

# Activepieces runtime
AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js
AP_ENVIRONMENT=prod
AP_EXECUTION_MODE=SANDBOX_CODE_ONLY
AP_WORKER_CONCURRENCY=1
AP_REUSE_SANDBOX=true
AP_NETWORK_MODE=STRICT
AP_FLOW_TIMEOUT_SECONDS=600
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5
AP_EXECUTION_DATA_RETENTION_DAYS=30
AP_TELEMETRY_ENABLED=false
AP_TOOL_SEARCH_ENABLED=false
AP_TEMPLATES_SOURCE_URL=https://cloud.activepieces.com/api/v1/flow-templates

# TechFlow signed Webhook ingress
TECHFLOW_WEBHOOK_LISTEN_HOST=0.0.0.0
TECHFLOW_WEBHOOK_LISTEN_PORT=8081
TECHFLOW_WEBHOOK_PATH_PREFIX=/techflow/hooks/
TECHFLOW_WEBHOOK_MAX_SKEW_SECONDS=300
TECHFLOW_WEBHOOK_EVENT_TTL_SECONDS=86400
TECHFLOW_WEBHOOK_BODY_LIMIT_BYTES=1048576
TECHFLOW_WEBHOOK_UPSTREAM_URL=
