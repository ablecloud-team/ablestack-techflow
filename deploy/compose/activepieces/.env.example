# Immutable release images. deploy-locked.sh generates an override from image-lock.json.
AP_IMAGE_REF=ghcr.io/activepieces/activepieces:0.86.3@sha256:208517c4f0d798a477a0c594bf432dd0f4918433f4b6f5b5f188a6e10e638c6c
POSTGRES_IMAGE_REF=pgvector/pgvector:0.8.0-pg14@sha256:c55d7e7deac05dde62139e0ded4fcf4f58363656cbc382dbea82fbed995aa767
REDIS_IMAGE_REF=redis:7.0.7@sha256:bb474c35022ca2c5618f4c49ca759bd2c0eea1daf5d934c560bd30092b97b498
CADDY_IMAGE_REF=caddy:2.8.4-alpine@sha256:af32e97399febea808609119bb21544d0265c58a02836576e32a2d082c262c17
TECHFLOW_GATEWAY_IMAGE=ablestack-techflow/event-gateway:0.3.0
TECHFLOW_GATEWAY_VERSION=0.3.0

# Private test-server listener and canonical public URL.
AP_BIND_ADDRESS=172.16.0.231
AP_HTTP_PORT=8080
AP_FRONTEND_URL=https://techflow.ablecloud.io
TECHFLOW_PUBLIC_URL=https://techflow.ablecloud.io

# Runtime-generated secrets. Never commit populated values.
AP_API_KEY=
AP_ENCRYPTION_KEY=
AP_JWT_SECRET=
AP_POSTGRES_PASSWORD=
AP_REDIS_PASSWORD=
TECHFLOW_WEBHOOK_SECRET=
TECHFLOW_WEBHOOK_SECRET_PREVIOUS=

# PostgreSQL
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=activepieces

# Redis
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379

# Activepieces runtime
AP_ENGINE_EXECUTABLE_PATH=dist/packages/engine/main.js
AP_ENVIRONMENT=prod
AP_EXECUTION_MODE=SANDBOX_CODE_ONLY
AP_WORKER_CONCURRENCY=1
AP_NETWORK_MODE=STRICT
# Issue #45: only the fixed AI Gateway and Activepieces control-plane addresses are exempted.
AP_SSRF_ALLOW_LIST=172.30.19.3/32,172.30.19.9/32
AP_REUSE_SANDBOX=true
AP_FLOW_TIMEOUT_SECONDS=600
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5
AP_EXECUTION_DATA_RETENTION_DAYS=30
AP_TELEMETRY_ENABLED=false
AP_TOOL_SEARCH_ENABLED=false
AP_TEMPLATES_SOURCE_URL=https://cloud.activepieces.com/api/v1/flow-templates

# TechFlow signed Webhook ingress
TECHFLOW_WEBHOOK_LISTEN_HOST=0.0.0.0
TECHFLOW_WEBHOOK_LISTEN_PORT=8081
TECHFLOW_WEBHOOK_PATH_PREFIX=/techflow/hooks/
TECHFLOW_WEBHOOK_MAX_SKEW_SECONDS=300
TECHFLOW_WEBHOOK_EVENT_TTL_SECONDS=86400
TECHFLOW_WEBHOOK_BODY_LIMIT_BYTES=1048576
TECHFLOW_WEBHOOK_UPSTREAM_URL=

# GitHub organization Webhook and internal Synology Chat adapter.
# The two URL/secret values are runtime secrets and must remain empty in Git.
TECHFLOW_GITHUB_WEBHOOK_PATH=/techflow/hooks/github/chat
TECHFLOW_GITHUB_ORGANIZATION=ablecloud-team
TECHFLOW_GITHUB_EVENT_TTL_SECONDS=604800
TECHFLOW_GITHUB_UPSTREAM_URL=
TECHFLOW_GITHUB_SOURCE_UPSTREAM_URL=
TECHFLOW_GITHUB_WEBHOOK_SECRET=
TECHFLOW_CHAT_INTERNAL_PATH=/internal/chat/github
TECHFLOW_CHAT_TIMEOUT_SECONDS=10
TECHFLOW_CHAT_MIN_INTERVAL_MILLISECONDS=600
TECHFLOW_CHAT_WEBHOOK_URL=

# Signed TechFlow RAG operation routes. Values point to internal Activepieces Webhooks.
TECHFLOW_RAG_DISCOVERY_PATH=/techflow/hooks/rag/discovery
TECHFLOW_RAG_DISCOVERY_UPSTREAM_URL=
TECHFLOW_RAG_REVIEW_PATH=/techflow/hooks/rag/review
TECHFLOW_RAG_REVIEW_UPSTREAM_URL=
TECHFLOW_RAG_COMPATIBILITY_PATH=/techflow/hooks/rag/compatibility
TECHFLOW_RAG_COMPATIBILITY_UPSTREAM_URL=
TECHFLOW_RAG_WITHDRAW_PATH=/techflow/hooks/rag/withdraw
TECHFLOW_RAG_WITHDRAW_UPSTREAM_URL=
TECHFLOW_RAG_EVALUATION_PATH=/techflow/hooks/rag/evaluation
TECHFLOW_RAG_EVALUATION_UPSTREAM_URL=
