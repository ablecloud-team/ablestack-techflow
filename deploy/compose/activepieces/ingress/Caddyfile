{
	admin off
	auto_https off
}

:8080 {
	@event_gateway path /techflow/hooks/*
	handle @event_gateway {
		reverse_proxy event-gateway:8081
	}

	@chat_assist {
		path /techflow/chat/assist
		method POST
	}
	handle @chat_assist {
		rewrite * /v1/chat/synology/events
		reverse_proxy techflow-ai-gateway:8090
	}

	@chat_assist_other path /techflow/chat/assist
	handle @chat_assist_other {
		respond 405
	}

	# All public Webhooks must pass through the validating Event Gateway.
	@direct_activepieces_webhook path /api/v1/webhooks/*
	handle @direct_activepieces_webhook {
		respond 404
	}

	handle {
		reverse_proxy app:80
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
	}
}
