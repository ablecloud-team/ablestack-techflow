{
	admin off
	auto_https off
}

:8080 {
	@event_gateway path /techflow/hooks/*
	handle @event_gateway {
		reverse_proxy event-gateway:8081
	}

	# All public Webhooks must pass through the validating Event Gateway.
	@direct_activepieces_webhook path /api/v1/webhooks/*
	handle @direct_activepieces_webhook {
		respond 404
	}

	handle {
		reverse_proxy app:80
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
	}
}
