[Unit]
Description=ABLESTACK Community encrypted consistent backup
After=network-online.target mariadb.service nginx.service php8.3-fpm.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/techflow-community-ops/community-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
