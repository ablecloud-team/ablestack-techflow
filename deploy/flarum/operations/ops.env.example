# Repository에는 비밀정보를 기록하지 않는다. 운영 값은 root:root 0600의
# /etc/techflow-community-ops/ops.env에 저장한다.
TECHFLOW_FLARUM_APP_ROOT=/var/www/html
TECHFLOW_FLARUM_BACKUP_ROOT=/var/backups/techflow-flarum/managed
TECHFLOW_COMMUNITY_STATE_ROOT=/var/lib/techflow-community-ops
TECHFLOW_COMMUNITY_LOG_ROOT=/var/log/techflow-community-ops
TECHFLOW_BACKUP_GPG_HOME=/var/lib/techflow-community-ops/gnupg
TECHFLOW_BACKUP_RECIPIENT=techflow-community-recovery
# 복구 호스트에만 설정한다. 운영 백업 서버에는 개인키와 암호 파일을 두지 않는다.
# TECHFLOW_BACKUP_GPG_PASSPHRASE_FILE=/srv/techflow-community-recovery/key-passphrase
# WSL 격리 복구 환경에서만 unix_socket DB 사용자를 지정한다.
# TECHFLOW_RESTORE_SOCKET_USER=www-data
TECHFLOW_BACKUP_RETENTION_DAYS=30
TECHFLOW_BACKUP_MAX_AGE_HOURS=30
TECHFLOW_FLARUM_LOCAL_URL=http://127.0.0.1/
TECHFLOW_FLARUM_PUBLIC_URL=https://community.ablecloud.io
TECHFLOW_FLARUM_HOST_HEADER=community.ablecloud.io
TECHFLOW_AI_HEALTH_URL=https://techflow.ablecloud.io/api/v1/health
TECHFLOW_DISK_WARN_PERCENT=70
TECHFLOW_DISK_CRITICAL_PERCENT=85
TECHFLOW_ALERT_COOLDOWN_SECONDS=3600
TECHFLOW_PHP_FPM_SERVICE=php8.3-fpm
TECHFLOW_ALLOWED_MAIL_DRIVERS=smtp
# WSL처럼 DB 계정이 unix_socket 인증을 사용할 때만 1로 설정한다.
TECHFLOW_DB_USE_ROOT_SOCKET=0
